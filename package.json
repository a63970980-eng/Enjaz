{
  "name": "enjaz",
  "private": true,
  "version": "0.1.0",
  "description": "ENJAZ AI Workforce SaaS Platform",
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "pg": "^8.16.3"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
