# Core application
DATABASE_URL=
# Database transport: TLS certificate verification is enabled by default.
# Use DATABASE_CA for a private CA; DATABASE_SSL=false is only for local/test databases.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA=
DB_POOL_SIZE=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_APPLICATION_NAME=enjaz-api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Multi-provider AI (server-side only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional future provider
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
OPENAI_MODEL=

# AI routing
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000

# Optional Paperclip AI workforce bridge (server-side only)
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
# JSON map of Enjaz workspace IDs to Paperclip company IDs; never map all tenants to one company.
PAPERCLIP_WORKSPACE_COMPANY_MAP={}
