# Core application
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=
# Database transport: TLS certificate verification is enabled by default.
# If your provider presents a private/self-signed chain, paste its trusted root CA PEM into DATABASE_CA (not a file path). Download it from Supabase Dashboard > Database > SSL Configuration. Never disable verification in production.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA=
DB_POOL_SIZE=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_APPLICATION_NAME=enjaz-api

# Supabase Auth — server-side values only.
# SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEY validates user access tokens.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to browser code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credential encryption: base64-encoded 32-byte key. Keep stable and secret.
# Generate a fresh key using a secure local secret manager; never commit its value.
ENJAZ_CREDENTIALS_KEY=

# Browser origin allowlist, comma-separated; do not use * in production.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# Multi-provider AI (server-side only)
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint override; only use a trusted provider.
OPENAI_BASE_URL=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
OPENAI_MODEL=
