# Core application
DATABASE_URL=
# Database transport: TLS certificate verification is enabled by default.
# Use DATABASE_CA for a private CA; DATABASE_SSL=false is only for local/test databases.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CA=
DB_POOL_SIZE=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
DB_IDLE_TRANSACTION_TIMEOUT_MS=10000
DB_APPLICATION_NAME=enjaz-api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable/anon key used to verify browser access tokens with Supabase Auth.
SUPABASE_ANON_KEY=

# Deployment
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120

# Integration credentials (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENJAZ_CREDENTIALS_KEY=

# Multi-provider AI (server-side only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional future provider
OPENAI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=openrouter/free
OPENAI_MODEL=

# AI routing
AI_PROVIDER=auto
AI_TIMEOUT_MS=30000

# Model spend accounting
# Tokens are always measured per planning call. Money is only derived when these
# per-1K-token rates are set; leave them empty to record usage without a price.
ENJAZ_MODEL_INPUT_CENTS_PER_1K=
ENJAZ_MODEL_OUTPUT_CENTS_PER_1K=
# Hard ceiling for a single task plan; an employee policy maxModelTokensPerTask overrides it.
ENJAZ_MAX_TASK_MODEL_TOKENS=120000
