# Public frontend configuration only. Never put service keys or access tokens here.
VITE_ENJAZ_API_BASE=https://YOUR-ENJAZ-API.example.com
VITE_ENJAZ_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_ENJAZ_SUPABASE_ANON_KEY=sb_publishable_...

# PostHog product analytics (public project token only — never a personal or secret key).
# Leave the token empty to keep analytics off; a missing token or host is a no-op.
VITE_POSTHOG_PROJECT_TOKEN=
# Ingestion host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU).
VITE_POSTHOG_HOST=https://us.i.posthog.com
